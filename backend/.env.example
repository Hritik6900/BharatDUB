GNANI_API_KEY=
GNANI_BASE=https://api.vachana.ai
GNANI_MAX_CONCURRENCY=1
LLM_BASE_URL=             # any OpenAI-compatible endpoint (Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
LLM_API_KEY=
LLM_MODEL=                # e.g. gemini-3.5-flash
LLM_MODEL_FAST=           # optional faster model for Live
LLM_REASONING_EFFORT=     # optional, e.g. none for Gemini Flash (stops hidden thinking from truncating replies)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
UPLOAD_TTL_HOURS=24
MAX_VIDEO_SECONDS=180
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE=http://localhost:8000
DATA_DIR=
STUDIO_SEPARATE=true
STUDIO_SPLIT_LONG_S=10   # a line longer than this is cut into lines of about 6 s at its sentences; 0 = off
FFMPEG_BIN=
FFPROBE_BIN=
LLM_REASONING_EFFORT_FAST=

# Optional: our own GPU voice engine for Live (IndicF5; see app/providers/tts_gpu.py). Empty = off.
GPU_VOICE_URL=

# Optional: Demucs on our own GPU machine for Studio (gpu_engine/sep_engine.py). Empty = CPU.
GPU_SEPARATE_URL=

# Optional: the all-GPU engine. Speech-to-text and translation also run on our GPU machine (gpu_engine/README.md); the
# hosted services above stay as the fallback. With both URLs set, the site shows an "Engine" choice on Live, Streamer
# and Studio, and a session or job uses the GPU engine only when it is picked there. AI_MODE is just the default for
# callers that do not choose: leave it at `cloud` and nothing changes for anybody who does not pick the GPU engine.
AI_MODE=cloud
GPU_STT_URL=              # e.g. http://127.0.0.1:9030 (gpu_engine/stt_engine.py)
GPU_LLM_URL=              # e.g. http://127.0.0.1:9020/v1 (vLLM, gpu_engine/start_llm.sh)

# ---------------- v1 (docs/v1/ARCHITECTURE.md) ----------------
# v1 runs beside v0 on its own ports and its own data folder. Never 3000, 8010 or 9001-9040.
#   DATA_DIR=/srv/bharatdb-v1/data   CORS_ORIGINS=http://localhost:3100   PUBLIC_API_BASE=http://localhost:8110
#
# V1_MODE (v1.2). `auto` is the default and what v1 runs with: nobody manages switches.
#   auto    backend/app/v1/mode.py decides what is on. The per-feature V1_* lines further down are NOT read.
#           Always on: the trace, the router, the API log, the breakers and the ladder, stock voices for a /live
#           session without a streamer profile, Studio HQ with its review, the 1.15x fit limit, adaptive takes, the
#           normaliser and the glossary of a job. The Live budget applies only while the dub is behind or speech is
#           dense, and a language that loses meaning gets a looser one. English is spoken in one voice, chosen once
#           at the session's start from a measurement. A line a voice refuses is spoken by another voice. Every
#           line passes the script guard; a dub line is judged against its source (Studio: every line; Live: a sample).
#           To switch ONE behaviour off: backend/config/overrides.yaml (every entry is commented out as shipped).
#   manual  every feature follows its own line below, as before v1.2: for measurements (a baseline beside auto),
#           the comparison backends (scripts/v1/ab-server.*) and the tests. What v1.2 added is off there.
# docs/v1/RUNBOOK.md section 3 has the whole list and how to go back.
V1_MODE=auto
V1_OVERRIDES_FILE=          # empty = backend/config/overrides.yaml
#
# ---- Manual mode only (V1_MODE=manual). In auto mode these lines are ignored. All off by default but V1_HQ_ADAPTIVE.
V1_TRACE=false              # trace per Live phrase and Studio line (JSONL in <DATA_DIR>/trace, Prometheus on /metrics)
V1_ROUTER=false             # providers from config/routing.yaml
V1_TTS_SERVER=false         # copied voice from V1_TTS_SERVER_URL instead of GPU_VOICE_URL
V1_TTS_MAYA=false           # Maya 2 as a second candidate voice in Studio HQ
V1_LIVE_STOCK_DEFAULT=false # a Live session without a streamer profile speaks in stock voices
V1_LIVE_LATE_SHORTEN=false  # a late line is said shorter instead of skipped
V1_LIVE_BACKCHECK=false     # a dubbed live line is heard back and made again if wrong
V1_STUDIO_HQ=false          # the HQ Studio path (quality=hq on a job)
V1_FIT_115=false            # Studio speed-up limit 1.15x instead of 1.35x
V1_API_LOG=false            # one record per outbound provider request (what, where, status, ms, sizes; no bodies) in V1_LOG_DIR/api
V1_BREAKER=false            # circuit breakers on our GPU endpoints + link-stall detector: a dead endpoint is left alone for 30 s, the next provider answers
V1_LIVE_DEGRADE=false       # Live steps down (copied voice, stock voice, captions only, original sound) and back up; never ends for a dead provider
V1_LIVE_BUDGET=false        # v1.1 dense speech: the translator gets the phrase's slot as words and letters, an answer over it by 15% is shortened once
V1_EN_SINGLE_VOICE=false    # v1.1: English in a GPU-engine session is spoken in one voice for the whole session, never chosen line by line
V1_EN_VOICE=auto            # manual mode, with V1_EN_SINGLE_VOICE: auto (the stock voice) | copy (the hosted copy for every line once the session has it) | stock. Auto mode measures instead (V1_EN_PROBE_TIMEOUT_S, V1_EN_PIPELINE_MS below); to pin a voice there: en_voice in overrides.yaml
# v1.1 Studio HQ toward 96% (all need V1_STUDIO_HQ; docs/v1/CALIBRATION.md, PROGRESS.md "v1.1 WS3")
V1_HQ_JUDGE=false           # the heard-back judge per language: hosted speech-to-text first, our GPU model next where it hears the language (Hindi); letters compared in one spelling; every line records who judged it
V1_HQ_JUDGE_ORDER=prisma,whisper_gpu,qa_server   # judges in order; whisper_gpu hears Hindi only, qa_server (V1_QA_URL) every language
V1_HQ_JUDGE_BY_LANG=        # another order for single languages, e.g. hi-IN=whisper_gpu,prisma
V1_HQ_CALIBRATE=false       # /studio/calibrate: label dubbed lines blind, see agreement with the judge and a recommended flag line (labels in <DATA_DIR>/calibration)
V1_HQ_CALIBRATE_MIN_LABELS=30
V1_HQ_ADAPTIVE=true         # one take first; more (up to V1_HQ_ADAPTIVE_MAX) only while the best score is under the threshold. On (decided 26 Nov 2026): 61% less voice time against five fixed takes (206 s against 524 s, three videos), same take kept on 76 of 76 lines; against v1's earlier rule the same 143 takes
V1_HQ_ADAPTIVE_MAX=5
V1_HQ_ADAPTIVE_SAME_STOP=false  # true: no further take once two takes were heard back as exactly the same words (measured on the same takes: 129 takes instead of 145, a lower-scored take kept on 3 of 76 lines)
V1_HQ_ADAPTIVE_MIN=0        # the threshold for more takes; 0 = V1_HQ_BACKCHECK_MIN
V1_HQ_TAKES_FIXED=0         # measurement only: always this many takes of a line in our voice (0 = off)
V1_HQ_NORMALISE=false       # numbers, dates, clock times, the rupee sign, %, units and short forms written out by rule before the voice (Hindi, Bengali, Tamil, English; other languages are left to the model step)
V1_HQ_AUTO_GLOSSARY=false   # names, brands and repeated English terms found in a job's transcript are that job's glossary
V1_HQ_AUTO_GLOSSARY_MAX=40
V1_HQ_REVIEW=false          # the hosted model reviews every translated line against the written rubric and may edit; edits logged (sizes and reason in the trace, the words in <DATA_DIR>/hq_review). An HQ job is ALWAYS reviewed, whatever this says (enforced in code since 26 Nov 2026): HQ on means review on
V1_LIVE_RECORD=false        # v1.1 pitch kit: a Live session made with record=true (the tick on /live, shown only while this is on) saves its dubbed audio and phrase times under <DATA_DIR>/recordings/<session>. Off, or without the ask: nothing is written
V1_RECORD_DIR=              # empty = <DATA_DIR>/recordings
V1_RECORD_KEEP_DAYS=30      # a kept recording is deleted by itself this many days after it ended (checked at start and every half hour); 0 = never by itself. One recording at once: DELETE /api/v1/recordings/<session> or the list on /live
V1_LISTEN_TEST=false        # v1.1 pitch kit: /listen-test, blind A/B pairs from <DATA_DIR>/listen/pairs (manifest: docs/v1/RUNBOOK.md), answers in <DATA_DIR>/listen/results.jsonl, summary on /metrics-ui
V1_LISTEN_DIR=              # empty = <DATA_DIR>/listen
LIVE_SYNC_EASE=true         # kill switch (on by default, a bug fix): after the viewers' hold grew during a slow link it comes back down to its normal value once phrases are ready early again. false = it only grows, as before
LIVE_SYNC_EASE_STEP_MS=250  # one step down; at most one every LIVE_SYNC_EASE_EVERY_MS, the first LIVE_SYNC_EASE_AFTER_MS after the last late phrase, and only while a phrase is ready this step + LIVE_SYNC_EASE_SPARE_MS before its moment
LIVE_SYNC_EASE_EVERY_MS=5000
LIVE_SYNC_EASE_AFTER_MS=20000
LIVE_SYNC_EASE_SPARE_MS=500
V1_GPU_STATS_URL=           # the GPU machine's own numbers for /health, e.g. http://127.0.0.1:9045/gpu (empty = V1_QA_URL + /gpu, else "unknown")
V1_LOG_DIR=                 # empty = logs/ at the top of the repository
V1_STORE=json               # json | postgres (POSTGRES_DSN)
POSTGRES_DSN=               # e.g. postgresql://bharatdb:<password>@127.0.0.1:5440/bharatdb
REDIS_URL=                  # e.g. redis://127.0.0.1:6390/0 ; empty = queue inside the backend process
V1_ROUTING_FILE=            # empty = backend/config/routing.yaml
# New model servers (gpu_engine_v1/). Empty = not running; the router uses the next provider.
V1_TTS_SERVER_URL=          # http://127.0.0.1:9041
V1_MAYA_URL=                # http://127.0.0.1:9042
V1_TRANSCRIBE_URL=          # http://127.0.0.1:9043
V1_BIG_LLM_URL=             # http://127.0.0.1:9044/v1
V1_BIG_LLM_MODEL=big
V1_QA_URL=                  # http://127.0.0.1:9045
# Cost per minute on /metrics-ui. A rate left at 0 is "not set" and nothing is shown for it.
V1_GPU_RATE_PER_HOUR=0
V1_COST_CURRENCY=USD
V1_STT_RATE_PER_MIN=0
V1_TTS_RATE_PER_1K_CHARS=0
V1_LLM_RATE_PER_CALL=0

# ---- Settings of auto mode (v1.2). First values. Measured as they are on 26 Nov 2026 (v1.2 Part 3,
# docs/handbook/experiments/EXP-031-auto-mode-dense-reel.md); none was changed afterwards. ----
# The auto budget: on for a language while its dub is behind, its lines are longer than their slots, or speech is dense.
V1_AUTO_BEHIND_ON_MS=500    # the backlog (running mean over the language's last lines) over this: budget on
V1_AUTO_BEHIND_OFF_MS=200   # ... and under this: no longer behind
V1_AUTO_RATIO_ON=1.15       # dubbed length over the slot (running mean) over this: budget on
V1_AUTO_RATIO_OFF=1.05
V1_AUTO_WPS_ON=4.0          # source words a second over the last 30 s over this: dense (beside the 70% speaking share)
V1_AUTO_WPS_OFF=3.2
V1_AUTO_MIN_ON_MS=15000     # once on, the budget stays on at least this long
V1_AUTO_CALM_LINES=4        # ... and until this many lines in a row gave no reason for it
V1_DENSE_MAX_TEMPO=1.3      # dense speech: the speed-up limit (1.4 was measured in v1.1 and never heard by anyone)
# The meaning check: a sample of spoken lines judged against its source by a model, after the fact.
V1_MEANING_SAMPLE_EVERY=3   # every n-th spoken line of a language while its budget is on
V1_MEANING_IDLE_EVERY=8     # ... and while it is off (content shift only)
V1_MEANING_WINDOW=12        # the rate is over the last this many judged budgeted lines
V1_MEANING_MIN_SAMPLES=6    # no adjustment on fewer
V1_MEANING_MAX=0.25         # share that lost meaning over which the budget loosens a step
V1_MEANING_LOW=0.10         # ... and at or under which it may tighten a step again, while the dub is behind
V1_MEANING_STEP=0.1         # one step: this much more of the slot
V1_MEANING_MAX_STEPS=3      # at this many steps the language is translated in full
V1_MEANING_TIGHTEN_AFTER_S=120
V1_MEANING_TIMEOUT_S=8
V1_MEANING_QUEUE=6          # lines waiting to be judged; a line that finds it full is not judged (and counted)
# The English voice: one probe line in the copied voice at the session's start, timed against the time a line has.
V1_EN_PROBE_TIMEOUT_S=6     # no answer in this time = the copy is not in time: the stock voice
V1_EN_PIPELINE_MS=3800      # of the viewers' hold, what is gone before the voice is asked (the phrase, about 2.2 s, and its text, about 1.6 s)

# ---- Removed (a line that still sets one of them is ignored, in either mode; the backend starts) ----
# v1.1 WS6: V1_SPEC_TRANSLATE, V1_LLM_PREFIX_CACHE. v1.2: V1_PHRASE_DYNAMIC, V1_LIVE_NATIVE_SPEED, V1_LIVE_WARMSTART,
# V1_LIVE_RATECTRL (the controller now runs only inside the auto budget) and their settings (V1_FIRST_PHRASE_*,
# V1_PHRASE_*_WORDS, V1_MERGE_UNDER_WORDS, V1_NATIVE_*, V1_WARM_*).
