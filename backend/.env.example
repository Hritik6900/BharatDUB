GNANI_API_KEY=
GNANI_BASE=https://api.vachana.ai
GNANI_MAX_CONCURRENCY=1
LLM_BASE_URL=             # any OpenAI-compatible endpoint (Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
LLM_API_KEY=
LLM_MODEL=                # e.g. gemini-3.5-flash
LLM_MODEL_FAST=           # optional faster model for Live
LLM_REASONING_EFFORT=     # optional, e.g. none for Gemini Flash (stops hidden thinking from truncating replies)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
UPLOAD_TTL_HOURS=24
MAX_VIDEO_SECONDS=180
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE=http://localhost:8000
DATA_DIR=
STUDIO_SEPARATE=true
FFMPEG_BIN=
FFPROBE_BIN=
LLM_REASONING_EFFORT_FAST=

# Optional: our own GPU voice engine for Live (IndicF5; see app/providers/tts_gpu.py). Empty = off.
GPU_VOICE_URL=

# Optional: Demucs on our own GPU machine for Studio (gpu_engine/sep_engine.py). Empty = CPU.
GPU_SEPARATE_URL=

# Optional: the all-GPU engine. Speech-to-text and translation also run on our GPU machine (gpu_engine/README.md); the
# hosted services above stay as the fallback. With both URLs set, the site shows an "Engine" choice on Live, Streamer
# and Studio, and a session or job uses the GPU engine only when it is picked there. AI_MODE is just the default for
# callers that do not choose: leave it at `cloud` and nothing changes for anybody who does not pick the GPU engine.
AI_MODE=cloud
GPU_STT_URL=              # e.g. http://127.0.0.1:9030 (gpu_engine/stt_engine.py)
GPU_LLM_URL=              # e.g. http://127.0.0.1:9020/v1 (vLLM, gpu_engine/start_llm.sh)

# ---------------- v1 (docs/v1/ARCHITECTURE.md) ----------------
# v1 runs beside v0 on its own ports and its own data folder. Never 3000, 8010 or 9001-9040.
#   DATA_DIR=/srv/bharatdb-v1/data   CORS_ORIGINS=http://localhost:3100   PUBLIC_API_BASE=http://localhost:8110
# Every new behaviour is behind a flag, default off. With all of them off v1 behaves as v0.
V1_TRACE=false              # trace per Live phrase and Studio line (JSONL in <DATA_DIR>/trace, Prometheus on /metrics)
V1_ROUTER=false             # providers from config/routing.yaml
V1_PHRASE_DYNAMIC=false     # first phrase 4-6 words, later 8-12, lines under 3 words join the next
V1_SPEC_TRANSLATE=false     # translate a partial that has stood still for V1_SPEC_STABLE_MS
V1_TTS_SERVER=false         # copied voice from V1_TTS_SERVER_URL instead of GPU_VOICE_URL
V1_TTS_MAYA=false           # Maya 2 as a second candidate voice in Studio HQ
V1_LIVE_STOCK_DEFAULT=false # a Live session without a streamer profile speaks in stock voices
V1_LIVE_LATE_SHORTEN=false  # a late line is said shorter instead of skipped
V1_LIVE_BACKCHECK=false     # a dubbed live line is heard back and made again if wrong
V1_STUDIO_HQ=false          # the HQ Studio path (quality=hq on a job)
V1_FIT_115=false            # Studio speed-up limit 1.15x instead of 1.35x
V1_API_LOG=false            # one record per outbound provider request (what, where, status, ms, sizes; no bodies) in V1_LOG_DIR/api
V1_BREAKER=false            # circuit breakers on our GPU endpoints + link-stall detector: a dead endpoint is left alone for 30 s, the next provider answers
V1_LIVE_DEGRADE=false       # Live steps down (copied voice, stock voice, captions only, original sound) and back up; never ends for a dead provider
V1_LIVE_BUDGET=false        # v1.1 dense speech: the translator gets the phrase's slot as words and letters, an answer over it by 15% is shortened once
V1_LIVE_RATECTRL=false      # v1.1: PI controller on the dub's backlog scales that budget (1.0 to 0.6); dense mode over 70% speaking share (tighter, short lines joined, 1.4x)
V1_LIVE_NATIVE_SPEED=false  # v1.1: our voice engine speaks a long line up to 1.2x faster itself (never under 320 ms a word), the rest by tempo
V1_GPU_STATS_URL=           # the GPU machine's own numbers for /health, e.g. http://127.0.0.1:9045/gpu (empty = V1_QA_URL + /gpu, else "unknown")
V1_LOG_DIR=                 # empty = logs/ at the top of the repository
V1_STORE=json               # json | postgres (POSTGRES_DSN)
POSTGRES_DSN=               # e.g. postgresql://bharatdb:<password>@127.0.0.1:5440/bharatdb
REDIS_URL=                  # e.g. redis://127.0.0.1:6390/0 ; empty = queue inside the backend process
V1_ROUTING_FILE=            # empty = backend/config/routing.yaml
# New model servers (gpu_engine_v1/). Empty = not running; the router uses the next provider.
V1_TTS_SERVER_URL=          # http://127.0.0.1:9041
V1_MAYA_URL=                # http://127.0.0.1:9042
V1_TRANSCRIBE_URL=          # http://127.0.0.1:9043
V1_BIG_LLM_URL=             # http://127.0.0.1:9044/v1
V1_BIG_LLM_MODEL=big
V1_QA_URL=                  # http://127.0.0.1:9045
# Cost per minute on /metrics-ui. A rate left at 0 is "not set" and nothing is shown for it.
V1_GPU_RATE_PER_HOUR=0
V1_COST_CURRENCY=USD
V1_STT_RATE_PER_MIN=0
V1_TTS_RATE_PER_1K_CHARS=0
V1_LLM_RATE_PER_CALL=0
