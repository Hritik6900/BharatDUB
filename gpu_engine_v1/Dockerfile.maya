# :9042 Maya 2 Native. Its engine needs Python 3.10-3.12 and a CUDA 12.8 build of PyTorch (model card).
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3-pip git ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/* && ln -sf /usr/bin/python3.11 /usr/local/bin/python
ARG MAYA_COMMIT=main
RUN git clone https://github.com/MayaResearch/maya2-native /opt/maya3 && cd /opt/maya3 && git checkout ${MAYA_COMMIT} \
    && python -m pip install -e ".[server]" --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install fastapi==0.115.6 "uvicorn[standard]==0.34.0" python-multipart==0.0.20 soundfile==0.13.0
WORKDIR /srv
COPY common.py maya_server.py ./
EXPOSE 9042
CMD ["uvicorn", "maya_server:app", "--host", "127.0.0.1", "--port", "9042"]
