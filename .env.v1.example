# Values for docker-compose.v1.yml. Copy to .env.v1 (git-ignored) and fill in. Keys and flags are in backend/.env.
V1_DATA_DIR=/srv/bharatdb-v1/data
V1_BACKEND_PORT=8110
V1_WEB_PORT=3100
V1_REDIS_PORT=6390
V1_POSTGRES_PORT=5440
V1_POSTGRES_PASSWORD=
# What a browser calls. With the https profile: https://<domain> and wss://<domain>.
V1_PUBLIC_ORIGIN=http://localhost:8110
V1_PUBLIC_WS_ORIGIN=ws://localhost:8110
# https profile only.
V1_DOMAIN=
V1_DEMO_USER=demo
V1_DEMO_PASSWORD_HASH=
